# ==============================================================================
# 1. CORE PYTHON & VIRTUAL ENVIRONMENTS
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
pythonenv*/

# Jupyter Notebooks checkpoints
.ipynb_checkpoints
.virtual_env/

# ==============================================================================
# 2. HARDENED SECRETS LAYER (LLM & API Keys)
# ==============================================================================
# Strictly ignore local variables to prevent committing OpenAI, Anthropic, or database credentials
.env
.env.*
!.env.example
secrets.txt
*api_key*
credentials.json

# ==============================================================================
# 3. AI AGENT RUNTIME & VECTOR DATABASES
# ==============================================================================
# Local vector DB storages (Chroma, FAISS, LanceDB, Qdrant data)
.chroma/
chroma_db/
faiss_index/
.lancedb/
qdrant_storage/

# Agent execution traces, caches, and memory dumps
.langchain/
.langgraph/
.crewai/
.autogen/
agent_workspace/
agent_outputs/
runs/
logs/
*.log
job_logs/

# Local Model weights / LLMs (if downloading models locally e.g., HuggingFace, Ollama, ONNX)
models/
weights/
*.bin
*.pt
*.pth
*.gguf
*.onnx

# ==============================================================================
# 4. AI-CONTEXT & TOKEN-SAVING LAYER (IDE / Code Editors)
# ==============================================================================
# Prevents AI agents from wasting tokens reading local caches, indexing artifacts, or large vector arrays
.cursorignore
.cursorindexingignore
.aiexclude
.ruff_cache/
.mypy_cache/
.pytest_cache/

# ==============================================================================
# 5. IDE, OS, AND SYSTEM CLUTTER
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db