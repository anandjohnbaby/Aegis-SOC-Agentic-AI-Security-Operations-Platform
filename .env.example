# MOCK_MODE=true  -> demo data everywhere (no keys needed).
# MOCK_MODE=false -> NO mock data anywhere: real LLM, real/built-in scanners.
#                    Any failure (bad key, LLM error, ticketing down) is shown as an error.
MOCK_MODE=true

# LLM provider: groq | openrouter | mock
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ServiceNow (SOAR/ticketing) base URL. Leave EMPTY to disable ticketing in live mode.
SERVICENOW_URL=http://localhost:8001
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=admin

# Storage
CHROMA_DIR=./data/chroma
SQLITE_URL=sqlite:///./data/aegis.db

# Scan target used by the scanner agent
DEFAULT_SCAN_TARGET=http://localhost:5000

# Built-in scanners only scan localhost/private IPs. Set true ONLY for systems you own.
ALLOW_EXTERNAL_SCANS=false
